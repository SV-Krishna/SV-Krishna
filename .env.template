# Core mode
NODE_ENV=development
LOG_LEVEL=info
ENABLE_WEB_UI=true
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8080
ENABLE_WAKE_WORD=false
WAKE_WORD_PHRASE=Krishna
WAKE_WORD_CONFIG_PATH=/opt/svkrishna/config/wake-word.json
WAKE_WORD_PYTHON=python3
WAKE_WORD_MODEL_PATH=/opt/svkrishna/models/openwakeword/krishna.onnx
WAKE_WORD_THRESHOLD=0.3
WAKE_WORD_CHUNK_SIZE=1280
WAKE_WORD_COOLDOWN_MS=8000
ENABLE_EMBEDDING_POC=false
EMBEDDING_MODEL=all-minilm:33m
EMBEDDING_STORE_PATH=/opt/svkrishna/rag/embeddings.json
EMBEDDING_TOP_K=3

# Runtime mode
PUSH_TO_TALK_KEY=space
# Note: on some Raspberry Pi setups `default` may fail for USB microphones.
# If recording fails, run `arecord -L` and set an explicit device, e.g.:
# AUDIO_INPUT_DEVICE=plughw:CARD=UACDemoV10,DEV=0
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default
# For development, defaults are under ./local/svkrishna/* if unset.
# For production installs, /opt/svkrishna/* is typical.
AUDIO_WORK_DIR=/opt/svkrishna/audio
AUDIO_RECORD_SECONDS=5
AUDIO_USE_VAD=true
# VAD mode (sox): stop when speech ends, with max guard to avoid hanging capture.
AUDIO_VAD_MIN_SPEECH_SECONDS=1
AUDIO_VAD_SILENCE_SECONDS=1
AUDIO_VAD_MAX_SECONDS=8
AUDIO_VAD_THRESHOLD_PERCENT=2
AUDIO_SAMPLE_RATE=16000
ENABLE_AUDIO_PLAYBACK_DEBUG=false
WHISPER_LANGUAGE=en
ENABLE_TTS=true
ENABLE_RAG=true
RAG_SOURCE_DIR=/opt/svkrishna/rag/inbox
RAG_STORE_PATH=/opt/svkrishna/rag/store.json
VESSEL_CONTEXT_PATH=/opt/svkrishna/config/vessel-context.md
RAG_CHUNK_SIZE=120
RAG_CHUNK_OVERLAP=30
RAG_TOP_K=3
RAG_EXTRACTOR_PYTHON=python3
# pypdf: fastest, basic PDF text extraction
# docling: structure-aware extraction (headings/tables) if docling is installed
RAG_EXTRACTOR_MODE=pypdf
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=/path/to/piper/voice/model.onnx
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=false
WHISPER_HOST=127.0.0.1
WHISPER_PORT=9001

# Service endpoints
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
WHISPER_ENDPOINT=http://127.0.0.1:9001
PIPER_ENDPOINT=http://127.0.0.1:9002

# Feature toggles
ENABLE_WHISPER_HTTP=true
ENABLE_PIPER_HTTP=false
OLLAMA_SYSTEM_PROMPT=You are a concise offline boat assistant for SV Krishna. Answer clearly and briefly.

# Waveshare ESP32-S3-Relay-6CH (MAIN_WIFI_STA demo) integration
# The demo exposes HTTP endpoints like:
#   GET /getData  -> JSON array (6 relay flags)
#   GET /Switch1..6, /AllOn, /AllOff
RELAY_CONTROL_ENABLED=false
RELAY_BASE_URL=http://192.168.1.50
RELAY_REQUIRE_CONFIRMATION=true

# Marine telemetry PoC wiring (reserved for future integration)
# These values are not consumed by the current runtime yet.
# They document the planned SignalK/Influx/MCP endpoint layout.
MARINE_TELEMETRY_ENABLED=false
SIGNALK_URL=http://127.0.0.1:3000
SIGNALK_HOST=127.0.0.1
SIGNALK_PORT=3000
SIGNALK_TLS=false
# Optional fallback draft (meters) when `design.draft.maximum` is missing in SignalK.
# Used for depth fallback: belowSurface = belowTransducer + draft.
SIGNALK_DRAFT_MAX_M=0
# Optional remote SignalK source for position fallback (e.g. live Pi on 206).
REMOTE_SIGNALK_URL=
# Optional bearer token for REMOTE_SIGNALK_URL
REMOTE_SIGNALK_TOKEN=
# Max acceptable age for remote navigation.position timestamp
REMOTE_SIGNALK_POSITION_MAX_AGE_SECONDS=30
SIGNALK_ALIAS_STORE_PATH=/opt/svkrishna/config/signalk-alias-store.json
# Optional bearer token for authenticated/remote SignalK servers
# SIGNALK_TOKEN=
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_ORG=svkrishna
INFLUXDB_BUCKET=signalk
# Use a dedicated read-only token for query operations
INFLUXDB_TOKEN=replace-with-read-only-token
# MCP sidecar process commands (used when MARINE_TELEMETRY_ENABLED=true)
SIGNALK_MCP_COMMAND=npx
SIGNALK_MCP_ARGS=-y signalk-mcp-server
INFLUXDB_MCP_COMMAND=npx
INFLUXDB_MCP_ARGS=-y influxdb-mcp-server --stdio
MARINE_MCP_REQUEST_TIMEOUT_MS=15000
MARINE_MCP_MAX_CALLS=4
SIGNALK_ALERT_MONITOR_ENABLED=false
# Comma-separated SignalK notification paths to monitor (prefix `notifications.` optional)
SIGNALK_ALERT_PATHS=notifications.environment.depth.belowTransducer
SIGNALK_ALERT_POLL_MS=2000
SIGNALK_ALERT_REPEAT_SECONDS=30
# Optional non-LLM intent routing (Rasa)
ENABLE_RASA_INTENT_ROUTER=false
RASA_ENDPOINT=http://127.0.0.1:5005
# Integer percentage (0-100)
RASA_INTENT_MIN_CONFIDENCE=70
ENABLE_HARNESS_EVAL=false
HARNESS_EVAL_LOG_PATH=/opt/svkrishna/logs/harness-eval.jsonl
# InfluxDB MCP HTTP sidecar (optional)
INFLUX_MCP_HTTP_PORT=8042
